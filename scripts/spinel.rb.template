class Spinel < Formula
  desc "Ahead-of-time compiler from Ruby to native executables"
  homepage "https://github.com/matz/spinel"
  url "https://github.com/dentarg/homebrew-tap/releases/download/__TAG__/__ARCHIVE__"
  sha256 "__SHA256__"
  license "MIT"

  depends_on "pkgconf" => :build
  depends_on "openssl@3"

  uses_from_macos "libffi"
  uses_from_macos "zlib"

  def install
    # Spinel links a program's -lssl from the directory it records here. Its
    # own probe leaves it empty when OpenSSL is on the build's search path,
    # as in Homebrew's build environment, but not when spinel runs later.
    system "make", "install", "PREFIX=#{prefix}", "SPINEL_OPENSSL_LIBDIR=#{formula_opt_lib("openssl@3")}"
  end

  test do
    (testpath/"hello.rb").write <<~RUBY
      require "openssl"
      puts "Hello, Spinel!"
      puts OpenSSL::Digest::SHA256.hexdigest("spinel")[0, 16]
    RUBY
    system bin/"spinel", "hello.rb", "-o", "hello"
    assert_equal "Hello, Spinel!\n098a942d46556cb0\n", shell_output("./hello")
    assert_match version.to_s.sub(/-(\d+)$/, "+\\1"), shell_output("#{bin}/spinel --version")
  end
end
