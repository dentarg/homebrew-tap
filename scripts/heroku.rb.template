class Heroku < Formula
  desc "Manage Heroku apps with dentarg's local fixes"
  homepage "https://github.com/dentarg/heroku-cli"
  url "https://github.com/dentarg/homebrew-tap/releases/download/__TAG__/heroku-__VERSION__.tgz"
  sha256 "__SHA256__"
  license "ISC"
  revision __REVISION__

  depends_on "node"

  def install
    system "npm", "install", *std_npm_args
    # tar-stream includes Bare runtime binaries that are unused by Node.js.
    libexec.glob("lib/node_modules/heroku/node_modules/bare-*/prebuilds").each(&:rmtree)

    (bin/"heroku").write_env_script libexec/"bin/heroku",
      PATH:                          "#{formula_opt_bin("node")}:$PATH",
      HEROKU_DISABLE_AUTOUPDATE:     "true",
      HEROKU_SKIP_NEW_VERSION_CHECK: "true",
      HEROKU_UPDATE_INSTRUCTIONS:    "update with: brew upgrade dentarg/tap/heroku"

    completions = libexec/"lib/node_modules/heroku/autocomplete-scripts/brew"
    bash_completion.install completions/"bash" => "heroku"
    zsh_completion.install completions/"zsh/_heroku"
  end

  def caveats
    <<~EOS
      To leave your global Git configuration untouched, add this to your shell configuration:
        export HEROKU_DISABLE_GIT_CONFIG=1

      Update this build with:
        brew upgrade dentarg/tap/heroku
    EOS
  end

  test do
    ENV["HEROKU_DISABLE_GIT_CONFIG"] = "1"
    ENV["DISABLE_TELEMETRY"] = "true"
    ENV.delete("HEROKU_FORCE_VERSION_CACHE_UPDATE")
    ENV["HEROKU_CACHE_DIR"] = (testpath/"cache").to_s
    (testpath/"cache").mkpath
    (testpath/"cache/version").write({ latest: "999999.0.0" }.to_json)
    File.utime(Time.at(0), Time.at(0), testpath/"cache/version")
    (testpath/".gitconfig").write "# user-managed Git configuration\n", mode: "a"
    original_git_config = (testpath/".gitconfig").read

    assert_match "heroku/#{version}", shell_output("#{bin}/heroku --version")
    # A cached update notice on stderr must not corrupt the JSON output.
    commands = JSON.parse(shell_output("#{bin}/heroku commands --json 2>&1"))
    assert commands.any? { |command| command.fetch("id") == "apps" }
    assert_equal original_git_config, (testpath/".gitconfig").read
  end
end
